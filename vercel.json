{
    "version": 2,
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "env": {
        "NODE_ENV": "production"
    },
    "functions": {
        "dist/index.js": {
            "runtime": "nodejs20.x",
            "maxDuration": 60
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/dist/index.js"
        }
    ]
}