generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String
  name             String
  role             String    // SUPER_ADMIN, ADMIN, BRANCH_MANAGER
  branchId         Int?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  resetToken       String?
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  location  String
  users     User[]
  assets    Asset[]
  transfersFrom TransferRequest[] @relation("FromBranch")
  transfersTo   TransferRequest[] @relation("ToBranch")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Reference Data Models
model AssetType {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  shortCode String   @unique
  assets    Asset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Center {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  shortCode String   @unique
  assets    Asset[]
  sections  Section[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Section {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  shortCode       String   @unique
  centerId        Int?
  center          Center?  @relation(fields: [centerId], references: [id])
  assets          Asset[]  @relation("AssetSection")
  currentAssets   Asset[]  @relation("AssetCurrentSection")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model BoardOfSurveyCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  assets    Asset[]
  createdAt DateTime @default(now())
}

model BoardOfSurveyYear {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  assets    Asset[]
  createdAt DateTime @default(now())
}

// Expanded Asset Model
model Asset {
  id                      Int                     @id @default(autoincrement())
  assetId                 String                  @unique // Custom ID like OFF-001
  assetCode               String?                 @unique // Full code like GJRTI/CC/RD-AN/LBE/0001
  name                    String
  category                String?                 // Legacy field - Computer Accessory, Office Furniture
  status                  String                  // Active, Damaged, Disposed, InTransit
  value                   Float
  
  // Foreign Keys for Reference Data
  assetTypeId             Int?
  assetType               AssetType?              @relation(fields: [assetTypeId], references: [id])
  
  centerId                Int?
  center                  Center?                 @relation(fields: [centerId], references: [id])
  
  sectionId               Int?
  section                 Section?                @relation("AssetSection", fields: [sectionId], references: [id])
  
  currentSectionId        Int?
  currentSection          Section?                @relation("AssetCurrentSection", fields: [currentSectionId], references: [id])
  
  branchId                Int
  branch                  Branch                  @relation(fields: [branchId], references: [id])
  
  boardOfSurveyCategoryId Int?
  boardOfSurveyCategory   BoardOfSurveyCategory?  @relation(fields: [boardOfSurveyCategoryId], references: [id])

  boardOfSurveyYearId     Int?
  boardOfSurveyYear       BoardOfSurveyYear?      @relation(fields: [boardOfSurveyYearId], references: [id])
  
  // Detailed Asset Information
  quantity                Int                     @default(1)
  inventoryPageNo         String?
  purchaseDate            DateTime?
  purchasePrice           Float?
  grnNumber               String?
  remarks                 String?
  revaluationPrice        Float?
  transferredToConsumable Boolean                 @default(false)
  currentLocation         String?
  
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  history                 AssetHistory[]
  transferRequests        TransferRequest[]
}

model AssetHistory {
  id        Int      @id @default(autoincrement())
  assetId   Int
  asset     Asset    @relation(fields: [assetId], references: [id])
  action    String   // CREATED, TRANSFERRED, UPDATED, DISPOSED
  details   String?
  userId    Int?     // Who performed the action
  createdAt DateTime @default(now())
}

model TransferRequest {
  id          Int      @id @default(autoincrement())
  assetId     Int
  asset       Asset    @relation(fields: [assetId], references: [id])
  fromBranchId Int
  fromBranch  Branch   @relation("FromBranch", fields: [fromBranchId], references: [id])
  toBranchId  Int
  toBranch    Branch   @relation("ToBranch", fields: [toBranchId], references: [id])
  status      String   // PENDING, APPROVED, REJECTED, COMPLETED
  requestDate DateTime @default(now())
  approvedDate DateTime?
  reason      String?
  remarks     String? // Comments from approver/rejector
}
